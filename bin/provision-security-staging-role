#!/usr/bin/env ruby

require "bundler/setup"
require "dotenv"
require "pg"
require "securerandom"
require "uri"

EXPECTED_HOST = "ep-silent-butterfly-za3t0sy6.c-2.eu-west-2.aws.neon.tech"
OWNER_FILE = File.expand_path("../.env.security-staging", __dir__)
RUNTIME_FILE = File.expand_path("../.env.security-staging-runtime", __dir__)

owner_url = Dotenv.parse(OWNER_FILE).fetch("STAGING_DATABASE_URL", "").strip
abort "STAGING_DATABASE_URL vazia" if owner_url.empty?
owner_uri = URI.parse(owner_url)
abort "Destino incorreto" unless owner_uri.host == EXPECTED_HOST && owner_uri.path == "/neondb" && owner_uri.user == "neondb_owner"
abort "O ficheiro de runtime já existe; não substituir credenciais automaticamente" if File.exist?(RUNTIME_FILE)

password = SecureRandom.hex(32)
connection = PG.connect(owner_url)
begin
  exists = connection.exec_params("SELECT 1 FROM pg_roles WHERE rolname = $1", [ "bread_app" ]).ntuples.positive?
  abort "A role bread_app já existe; rever antes de continuar" if exists

  connection.exec("BEGIN")
  connection.exec("CREATE ROLE bread_app LOGIN PASSWORD #{connection.escape_literal(password)} NOSUPERUSER NOBYPASSRLS NOINHERIT")
  runtime_uri = owner_uri.dup
  runtime_uri.user = "bread_app"
  runtime_uri.password = password
  File.open(RUNTIME_FILE, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
    file.write("STAGING_RUNTIME_DATABASE_URL=#{runtime_uri}\n")
  end
  connection.exec("COMMIT")
  puts "Role restrita criada na branch de testes; credencial guardada localmente com modo 0600."
rescue StandardError
  connection.exec("ROLLBACK")
  abort "Não foi possível concluir. Rever a role e o ficheiro local antes de repetir; nenhuma role existente foi eliminada."
ensure
  connection.close
end
