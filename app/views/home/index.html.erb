<div class="container">
  <h1 class="page-title">Gestão de Entregas de Pão</h1>
  <p class="subtitle">Bem-vindo, <strong><%= current_user.email %></strong></p>

  <% if current_user.admin? %>
    <section>
      <h2 class="section-title">Área de administração</h2>

      <div class="card-grid">
        <div class="card">
          <div class="card-icon">👥</div>
          <h3 class="card-title">Utilizadores</h3>
          <p class="card-text">Crie contas de clientes, distribuidores, padeiro e administradores.</p>
          <%= link_to "Abrir", users_path, class: "btn btn-primary" %>
        </div>

        <div class="card">
          <div class="card-icon">🧍‍♀️</div>
          <h3 class="card-title">Clientes</h3>
          <p class="card-text">Consulte os clientes ativos e inativos.</p>
          <%= link_to "Abrir", customers_path, class: "btn" %>
        </div>

        <div class="card">
          <div class="card-icon">🗺️</div>
          <h3 class="card-title">Rotas</h3>
          <p class="card-text">Configure as rotas semanais.</p>
          <%= link_to "Abrir", routes_path, class: "btn" %>
        </div>

        <div class="card">
          <div class="card-icon">📦</div>
          <h3 class="card-title">Agenda semanal</h3>
          <p class="card-text">Acompanhe todas as entregas e os seus estados.</p>
          <%= link_to "Abrir", route_runs_path, class: "btn" %>
        </div>
        <div class="card bread-requests-card">
          <% if @unsubmitted_bread_requests.positive? %>
            <span class="request-status request-status-alert" aria-label="<%= @unsubmitted_bread_requests %> pedidos por submeter" title="Pedidos por submeter"><%= @unsubmitted_bread_requests %></span>
          <% else %>
            <span class="request-status request-status-ok" aria-label="Todos os pedidos foram submetidos" title="Todos os pedidos foram submetidos">✓</span>
          <% end %>
          <div class="card-icon">🍞</div>
          <h3 class="card-title">Pedidos de pão</h3>
          <p class="card-text">Aprove as quantidades pedidas pelos clientes.</p>
          <%= link_to "Ver pedidos", scheduled_stops_path, class: "btn" %>
        </div>
        <div class="card">
          <div class="card-icon">🚐</div>
          <h3 class="card-title">Veículos</h3>
          <p class="card-text">Adicione fotografias e atribua os veículos aos distribuidores.</p>
          <%= link_to "Gerir veículos", vehicles_path, class: "btn" %>
        </div>
        <div class="card">
          <div class="card-icon">👨‍🍳</div>
          <h3 class="card-title">Pão a preparar</h3>
          <p class="card-text">Consulte os totais de pão aprovados para cada dia.</p>
          <%= link_to "Ver semana", bakery_path, class: "btn" %>
        </div>
      </div>
    </section>
  <% elsif current_user.baker? %>
    <section class="card">
      <h2>Pão a preparar</h2>
      <p>Veja quantos pães precisa de preparar para amanhã e para cada dia da semana.</p>
      <%= link_to "Ver quantidades da semana", bakery_path, class: "btn btn-primary" %>
    </section>
  <% elsif current_user.customer? %>
    <section class="card">
      <div class="customer-bread-heading">
        <h2><span aria-hidden="true">🍞</span> O meu pão</h2>
        <div class="request-decision-labels" aria-label="Dias por estado da quantidade de pão">
          <% pending_days = @customer_request_day_counts.fetch("pending", 0) %>
          <% rejected_days = @customer_request_day_counts.fetch("rejected", 0) %>
          <% if pending_days.positive? %>
            <span class="request-decision-label request-decision-pending"><%= pending_days %> por aprovar</span>
          <% end %>
          <% if rejected_days.positive? %>
            <span class="request-decision-label request-decision-rejected"><%= rejected_days %> <%= rejected_days == 1 ? "Recusado" : "Recusados" %></span>
          <% end %>
        </div>
      </div>
      <p>Peça o pão para amanhã, se tiver entrega marcada. Envie o pedido até às 23h de hoje.</p>
      <%= link_to "Pedir pão e consultar pedidos", scheduled_stops_path, class: "btn btn-primary" %>
    </section>
  <% else %>
    <section>
      <h2 class="section-title">Área do distribuidor</h2>

      <div class="card-grid">
        <div class="card">
          <div class="card-icon">📦</div>
          <h3 class="card-title">As minhas rotas e entregas</h3>
          <p class="card-text">Consulte os clientes por ordem, obtenha direções e registe as entregas.</p>
          <%= link_to "Abrir", route_runs_path, class: "btn btn-primary" %>
        </div>

        <div class="card">
          <div class="card-icon">🚐</div>
          <h3 class="card-title">Veículos atribuídos</h3>
          <p class="card-text">Veja a fotografia e a matrícula dos seus veículos.</p>
          <%= link_to "Ver veículos", vehicles_path, class: "btn" %>
        </div>
      </div>
  </section>
<% end %>
</div>


<div class="logout">
  <%= button_to "Terminar sessão", destroy_user_session_path, method: :delete, class: "btn btn-logout" %>
</div>
