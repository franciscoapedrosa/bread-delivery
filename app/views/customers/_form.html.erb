<%= render "shared/error_messages", object: @customer, title: "Couldn't save customer:" %>

<%= form_with(model: @customer, local: true) do |form| %>
  <p>
    <%= form.label :name %><br>
    <%= form.text_field :name %>
  </p>

  <p>
    <%= form.label :address %><br>
    <%= form.text_field :address %>
  </p>

  <p>
    <%= form.label :bread_quantity %><br>
    <%= form.number_field :bread_quantity %>
  </p>

  <p><%= form.submit %></p>
<% end %>
