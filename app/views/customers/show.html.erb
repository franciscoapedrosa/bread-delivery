<h1>Cliente: <%= @customer.name %></h1>

<p>
  <strong>Morada:</strong>
  <%= @customer.address %>
</p>

<p>
  <strong>Conta:</strong>
  <%= @customer.user&.email || "Sem conta — associe este cliente em Utilizadores" %>
</p>

<h2>Rotas deste cliente</h2>
<% @customer.routes.each do |route| %><p><%= link_to route.name, route %></p><% end %>
<h2>Próximas entregas e quantidades</h2>
<div class="planning-grid">
  <% @customer.scheduled_stops.includes(route_run: :route).joins(:route_run).where(route_runs: { delivery_date: Date.current.. }).order("route_runs.delivery_date").each do |stop| %>
    <article class="card">
      <h3><%= delivery_date_label(stop.route_run.delivery_date) %></h3>
      <p><%= link_to stop.route_run.route.name, stop.route_run %></p>
      <p>Pedido: <%= stop.requested_quantity || "Por indicar" %> · Aprovado: <%= stop.approved_quantity || "Por aprovar" %></p>
      <p><%= approval_name(stop.approval_status) %></p>
      <span class="state-pill state-<%= stop.status %>"><%= delivery_status(stop.status) %></span>
    </article>
  <% end %>
</div>

<%= link_to "Editar", edit_customer_path(@customer), class: "btn btn-primary" %>
<%= link_to "Voltar", customers_path, class: "btn" %>
