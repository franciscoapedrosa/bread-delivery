<h1>Clientes</h1>

<%= link_to "Criar conta de cliente", new_user_path, class: "btn btn-primary" %>
<%= link_to "Aprovar pedidos de pão", scheduled_stops_path, class: "btn" %>

<h2>Clientes ativos</h2>
<table>
  <thead>
    <tr>
      <th>Nome</th>
      <th>Morada</th>
      <th>Pão aprovado esta semana</th>
      <th>Estado</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @active_customers.each do |customer| %>
      <tr>
        <td><%= link_to customer.name, customer_path(customer) %></td>
        <td><%= customer.address %></td>
        <td><%= customer.scheduled_stops.joins(:route_run).where(route_runs: { delivery_date: Date.current.all_week }).where.not(status: "cancelled").sum(:approved_quantity) %></td>
        <td>Ativo</td>
        <td>
          <div class="table-actions">
            <%= link_to "Editar", edit_customer_path(customer), class: "btn btn-small" %>
            <%= button_to "Desativar", deactivate_customer_path(customer), method: :patch, class: "btn btn-small btn-danger", form_class: "inline-form", data: { turbo_confirm: "Tem a certeza de que pretende desativar este cliente?" } %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>Clientes inativos</h2>
<table>
  <thead>
    <tr>
      <th>Nome</th>
      <th>Morada</th>
      <th>Quantidade de pão</th>
      <th>Estado</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @inactive_customers.each do |customer| %>
      <tr>
        <td><%= link_to customer.name, customer_path(customer) %></td>
        <td><%= customer.address %></td>
        <td><%= customer.bread_quantity %></td>
        <td>Inativo</td>
        <td>
        <%= button_to "Reativar", activate_customer_path(customer), method: :patch, class: "btn btn-small", data: { turbo_confirm: "Tem a certeza de que pretende reativar este cliente?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
