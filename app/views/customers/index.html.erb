<div data-controller="customer-search">
<div class="page-heading-row">
  <div>
    <h1>Clientes</h1>
    <p class="subtitle">Consulte e ative ou desative clientes.</p>
  </div>
  <div class="plan-actions">
    <%= link_to "Criar conta de cliente", new_user_path(origin: "customers"), class: "btn btn-primary" %>
    <%= link_to "Pedidos de pão", scheduled_stops_path(origin: "customers"), class: "btn" %>
  </div>
</div>

<div class="customer-search-field">
  <label for="customer-search">Pesquisar clientes</label>
  <input type="search" id="customer-search" placeholder="Escreva o nome do cliente…" autocomplete="off" data-customer-search-target="input" data-action="input->customer-search#filter" aria-controls="customers-list">
</div>
<p hidden role="status" data-customer-search-target="empty">Não foram encontrados clientes com esse nome.</p>

<% if @customers.empty? %>
  <section class="card empty-state">
    <h2>Ainda não existem clientes</h2>
    <p>Comece por criar uma conta de cliente.</p>
  </section>
<% else %>
  <div id="customers-list" data-customer-search-target="list">
  <% [true, false].each do |active| %>
    <% customers = @customers.select { |customer| customer.active? == active } %>
    <section class="detail-section" data-customer-search-target="group">
      <h2><%= active ? "Clientes ativos" : "Clientes inativos" %></h2>
      <% if customers.empty? %>
        <p class="empty-note">Não há clientes <%= active ? "ativos" : "inativos" %>.</p>
      <% else %>
  <div class="management-table-wrap">
    <table class="management-table customers-management-table">
      <thead><tr><th>Nome</th><th>Estado</th><th>Ações</th></tr></thead>
      <tbody>
        <% customers.each do |customer| %>
          <tr data-customer-search-target="customer" data-customer-name="<%= customer.name %>">
            <td data-label="Nome"><span class="customer-name"><%= customer.name %></span></td>
            <td data-label="Estado"><span class="state-pill <%= customer.active? ? 'state-delivered' : 'state-cancelled' %>"><%= customer.active? ? "Ativo" : "Inativo" %></span></td>
            <td data-label="Ações">
              <div class="table-actions">
                <%= link_to "Ver detalhes", customer_path(customer), class: "btn btn-small btn-secondary" %>
                <% if customer.active? %>
                  <%= button_to "Desativar", deactivate_customer_path(customer), method: :patch, class: "btn btn-small btn-danger", form_class: "inline-form", data: { turbo_confirm: "Desativar #{customer.name}?" } %>
                <% else %>
                  <%= button_to "Reativar", activate_customer_path(customer), method: :patch, class: "btn btn-small", form_class: "inline-form", data: { turbo_confirm: "Reativar #{customer.name}?" } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
      <% end %>
    </section>
  <% end %>
  </div>
<% end %>
</div>
