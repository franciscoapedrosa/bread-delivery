<% if customers.blank? %>
  <p>Não existem clientes atribuídos esta semana.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Cliente</th>
        <th>Morada</th>
        <th>Quantidade de pão</th>
        <th>Dias</th>
      </tr>
    </thead>
    <tbody>
      <% customers.each do |customer| %>
        <% days = (days_by_customer[customer.id] || []).map { |day| day_name(day) }.join(", ") %>
        <tr>
          <td><%= customer.name %></td>
          <td><%= customer.address %></td>
          <td><%= customer.bread_quantity %></td>
          <td><%= days.presence || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
