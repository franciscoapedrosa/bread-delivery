<h1>Entrega</h1>

<p>
  <strong>Rota:</strong>
  <%= @delivery.route.name %>
</p>

<p>
  <strong>Dia da semana:</strong>
  <%= day_name(@delivery.day_of_week) %>
</p>


<p>
  <strong>Cliente:</strong>
  <%= @delivery.customer.name %>
</p>

<p>
  <strong>Distributor:</strong>
  <%= @delivery.distributor.email %>
</p>

<p>
  <strong>Estado:</strong>
  <%= delivery_status(@delivery.status) %>
</p>

<%= link_to "Editar", edit_delivery_path(@delivery), class: "btn btn-primary" %>
<%= link_to "Voltar", deliveries_path, class: "btn" %>
