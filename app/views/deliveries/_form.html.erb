<%= render "shared/error_messages", object: @delivery, title: "Não foi possível guardar a entrega:" %>

<%= form_with(model: @delivery, local: true) do |form| %>
  <% if current_user.admin? %>
    <div>
      <%= form.label :route_id, "Rota" %><br>
      <%= form.collection_select :route_id, Route.all, :id, :name %>
    </div>

    <div>
      <%= form.label :customer_id, "Cliente" %><br>
      <%= form.collection_select :customer_id, Customer.active, :id, :name %>
    </div>

    <div>
      <%= form.label :distributor_id, "Distributor" %><br>
      <%= form.collection_select :distributor_id, User.where(role: "distributor"), :id, :email %>
    </div>

    <div>
      <%= form.label :day_of_week, "Dia da semana" %><br>
      <%= form.select :day_of_week, ApplicationHelper::DAYS_PT.map { |day, label| [label, day] } %>
    </div>
  <% end %>

  <div>
    <%= form.label :status, "Estado" %><br>
    <%= form.select :status, ApplicationHelper::STATUS_PT.map { |status, label| [label, status] } %>
  </div>

  <p><%= form.submit "Guardar", class: "btn btn-primary" %></p>
<% end %>
