<h1>Entregas</h1>

<div class="action-bar">
  <%= form_with url: reset_week_deliveries_path, method: :post, local: true, class: "week-action-form" do |f| %>
    <%= f.label :day, "Período a repor", class: "sr-only", for: "reset-day" %>
    <%= f.select :day,
          [["Toda a semana", ""]] + ApplicationHelper::DAYS_PT.map { |value, label| [label, value] },
          {}, class: "week-select", id: "reset-day" %>
    <%= f.submit "Repor estados", class: "btn btn-primary",
          data: { turbo_confirm: "Colocar as entregas selecionadas como pendentes?" } %>
  <% end %>

  <% if current_user.role == "admin" %>
    <%= form_with url: destroy_week_deliveries_path, method: :delete, local: true, class: "week-action-form" do |f| %>
      <%= f.label :day, "Período a eliminar", class: "sr-only", for: "delete-day" %>
      <%= f.select :day,
            [["Toda a semana", ""]] + ApplicationHelper::DAYS_PT.map { |value, label| [label, value] },
            {}, class: "week-select", id: "delete-day" %>
      <%= f.submit "Eliminar entregas", class: "btn btn-danger",
            data: { turbo_confirm: "Eliminar as entregas selecionadas? Esta ação não pode ser anulada." } %>
    <% end %>
  <% end %>
</div>


<% if current_user.admin? %>
  <%= link_to "Nova entrega", new_delivery_path, class: "btn btn-primary" %>

  <section class="weekly-summary">
    <h2 class="card-title">Resumo semanal</h2>
    <p class="card-text" style="margin:.25rem 0 1rem;">
      Total de pães esta semana: <strong><%= @weekly_total_admin %></strong>
    </p>

    <div class="summary-grid">
      <div class="summary-panel">
        <h3 class="card-title">Total por dia</h3>
        <table class="summary-table">
          <thead>
            <tr>
              <th>Dia</th>
              <th>Total de pães</th>
            </tr>
          </thead>
          <tbody>
            <% @day_totals_admin.each do |day, total| %>
              <% next if total.zero? %>
              <tr>
                <td><%= day_name(day) %></td>
                <td><%= total %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="summary-panel">
        <h3 class="card-title">Total por distribuidor</h3>
        <table class="summary-table">
          <thead>
            <tr>
              <th>Distribuidor</th>
              <th>Total de pães</th>
            </tr>
          </thead>
          <tbody>
            <% @totals_by_distributor.each do |user, total| %>
              <tr>
                <td><%= user&.email || "—" %></td>
                <td><%= total %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
<% end %>

<% if @deliveries_by_day.blank? %>
  <p>Não existem entregas esta semana.</p>
<% else %>
  <% @deliveries_by_day.each do |day, deliveries| %>
    <h2><%= day_name(day) %></h2>
    <table>
      <thead>
        <tr>
          <th>Rota</th>
          <th>Cliente</th>
          <% if current_user.role == "distributor" %>
            <th>Quantidade</th>
          <% end %>
          <th>Distribuidor</th>
          <th>Estado</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% deliveries.each do |delivery| %>
          <tr>
            <td><%= delivery.route.name %></td>
            <td><%= delivery.customer.name %></td>
            <% if current_user.role == "distributor" %>
              <td><%= delivery.customer.bread_quantity %></td>
            <% end %>
            <td><%= delivery.distributor.email %></td>
            <td><%= delivery_status(delivery.status) %></td>
            <td>
              <div class="table-actions">
                <%= link_to "Editar", edit_delivery_path(delivery), class: "btn btn-small" %>
                <% if current_user.admin? %>
                  <%= button_to "Eliminar", delivery_path(delivery), method: :delete,
                        class: "btn btn-small btn-danger", form_class: "inline-form",
                        data: { turbo_confirm: "Tem a certeza de que pretende eliminar esta entrega?" } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if current_user.role == "distributor" %>
          <tr style="font-weight:600; background:#f9fafb;">
            <td colspan="2">Total de pães</td>
            <td><%= @day_totals[day] %></td>
            <td colspan="3"></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>
