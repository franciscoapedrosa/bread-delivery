<!DOCTYPE html>
<html lang="pt-PT">
  <head>
    <title><%= content_for(:title) || "Gestão de Entregas de Pão" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <main class="site-shell">
      <% if user_signed_in? %>
        <nav class="top-nav" aria-label="Navegação principal">
          <% if controller_name == "users" && %w[new create edit update].include?(action_name) %>
            <%= link_to "Voltar", @user_back_path, class: "btn-back" %>
          <% elsif controller_name == "scheduled_stops" && action_name == "index" && params[:origin] == "customers" && current_user.admin? %>
            <%= link_to "Voltar", customers_path, class: "btn-back" %>
          <% elsif controller_name == "weekly_routes" %>
            <%= link_to "Voltar", route_runs_path, class: "btn-back" %>
          <% elsif controller_name == "scheduled_stops" && action_name == "index" && @history %>
            <%= link_to "Voltar", @history_back_path, class: "btn-back" %>
          <% elsif controller_name == "routes" && action_name == "show" %>
            <%= link_to "Voltar às rotas", routes_path, class: "btn-back" %>
          <% elsif controller_name == "routes" && %w[edit update].include?(action_name) %>
            <%= link_to "Voltar", @edit_back_path, class: "btn-back" %>
          <% elsif controller_name == "customers" && action_name == "show" %>
            <%= link_to "Voltar", customers_path, class: "btn-back" %>
          <% elsif controller_name == "customers" && %w[edit update].include?(action_name) %>
            <%= link_to "Voltar", @edit_back_path, class: "btn-back" %>
          <% elsif controller_name == "route_runs" && %w[show update].include?(action_name) %>
            <%= link_to "Voltar", @route_runs_back_path, class: "btn-back" %>
          <% else %>
            <%= link_to "Voltar ao início", authenticated_root_path, class: "btn-back" %>
          <% end %>
        </nav>
      <% end %>

      <% if flash.any? %>
        <div class="flash-toasts" aria-live="polite">
          <% flash.each do |type, message| %>
            <div class="flash flash-toast <%= type %>"
                 role="<%= type.to_s == 'alert' ? 'alert' : 'status' %>"
                 data-controller="toast">
              <span><%= message %></span>
              <button type="button" class="flash-close" aria-label="Fechar mensagem" data-action="toast#close">×</button>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
