<h1>Routes</h1>

<% if current_user.admin? %>
  <%= link_to "New Route", new_route_path, class: "btn btn-primary" %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @routes.each do |route| %>
        <tr>
          <td><%= route.name %></td>
          <td>
            <%= link_to "Edit", edit_route_path(route) %> |
            <%= button_to "Delete", route_path(route), method: :delete, data: { confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <h2>My Routes This Week</h2>

  <% order = %w[monday tuesday wednesday thursday friday saturday sunday] %>

  <% order.each do |day| %>
    <h3><%= day.capitalize %></h3>
    <% if @routes_by_day[day].present? %>
      <ul>
        <% @routes_by_day[day].each do |route| %>
          <li><%= route.name %></li>
        <% end %>
      </ul>
    <% else %>
      <p>No routes assigned</p>
    <% end %>
  <% end %>
<% end %>
