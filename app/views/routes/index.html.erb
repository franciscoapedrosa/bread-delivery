<h1>Rotas</h1>

<% if current_user.admin? %>
  <%= link_to "Nova rota", new_route_path, class: "btn btn-primary" %>
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @routes.each do |route| %>
        <tr>
          <td><%= link_to route.name, route %></td>
          <td>
            <div class="table-actions">
              <%= link_to "Clientes e percurso", route, class: "btn btn-small btn-primary" %>
              <%= link_to "Editar", edit_route_path(route), class: "btn btn-small" %>
              <%= button_to "Eliminar", route_path(route), method: :delete, class: "btn btn-small btn-danger", form_class: "inline-form", data: { turbo_confirm: "Tem a certeza?" } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <h2>As minhas rotas desta semana</h2>

  <% order = %w[monday tuesday wednesday thursday friday saturday sunday] %>

  <% order.each do |day| %>
    <h3><%= day_name(day) %></h3>
    <% if @routes_by_day[day].present? %>
      <ul>
        <% @routes_by_day[day].each do |route| %>
          <li><%= route.name %></li>
        <% end %>
      </ul>
    <% else %>
      <p>Não existem rotas atribuídas.</p>
    <% end %>
  <% end %>
<% end %>
