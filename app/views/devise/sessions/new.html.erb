<div class="auth-card">
  <h1>Iniciar sessão</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |form| %>
    <div class="field">
      <%= form.label :email, "Email" %><br>
      <%= form.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= form.label :password, "Palavra-passe" %><br>
      <%= form.password_field :password, autocomplete: "current-password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field checkbox-field">
        <%= form.check_box :remember_me %>
        <%= form.label :remember_me, "Manter sessão iniciada" %>
      </div>
    <% end %>

    <div class="actions">
      <%= form.submit "Entrar", class: "btn btn-primary" %>
    </div>
  <% end %>

  <%= link_to "Esqueceu-se da palavra-passe?", new_password_path(resource_name) if devise_mapping.recoverable? %>
</div>
