<div class="auth-card">
  <h1>Recuperar palavra-passe</h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |form| %>
    <%= render "devise/shared/error_messages", resource: resource if lookup_context.exists?("devise/shared/_error_messages") %>

    <div class="field">
      <%= form.label :email, "Email" %><br>
      <%= form.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="actions">
      <%= form.submit "Enviar instruções", class: "btn btn-primary" %>
    </div>
  <% end %>

  <%= link_to "Voltar ao início de sessão", new_session_path(resource_name) %>
</div>
