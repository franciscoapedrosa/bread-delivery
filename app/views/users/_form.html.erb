<%= form_with(model: @user, local: true, data: { controller: "user-role" }) do |form| %>
  <% if @user.errors.any? %>
    <div class="error-messages">
      <h2>Não foi possível guardar o utilizador:</h2>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :email %><br>
    <%= form.text_field :email %>
  </div>

  <div class="field">
    <%= form.label :password, action_name == "new" ? "Palavra-passe" : "Nova palavra-passe" %><br>
    <%= form.password_field :password, autocomplete: "new-password" %>
    <% unless action_name == "new" %>
      <small class="field-hint">Deixe em branco para manter a palavra-passe atual.</small>
    <% end %>
  </div>

  <div class="field">
    <%= form.label :password_confirmation, "Confirmar palavra-passe" %><br>
    <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= form.label :role, "Função" %><br>
    <%= form.select :role, [["Administrador", "admin"], ["Distribuidor", "distributor"], ["Cliente", "customer"], ["Padeiro", "baker"]], {}, data: { user_role_target: "role", action: "change->user-role#toggle" } %>
    <p class="field-hint">A função Padeiro tem uma única conta, partilhada pela equipa, para consultar o pão a preparar.</p>
  </div>

  <fieldset class="card" <%= "hidden disabled" unless @user.customer? %> data-user-role-target="details">
    <legend>Dados para contas de cliente</legend>
    <p>Crie aqui o cliente e o local de entrega. Depois, o cliente entra na sua conta para submeter a quantidade de pão para os dias que marcar.</p>
    <% if @user.new_record? %>
      <%= label_tag "user_existing_customer_id", "Associar a um cliente que já existe (opcional)" %>
      <%= select_tag "user[existing_customer_id]", options_from_collection_for_select(Customer.where(user_id: nil).order(:name), :id, :name), include_blank: "Criar cliente novo com os dados abaixo" %>
    <% end %>
    <%= form.fields_for :customer, @user.customer || Customer.new do |fields| %>
      <p><%= fields.label :name, "Nome do cliente" %><%= fields.text_field :name %></p>
      <p><%= fields.label :address, "Morada completa (rua, número, código postal e localidade)" %><%= fields.text_field :address %></p>
    <% end %>
  </fieldset>

  <div class="actions">
    <%= form.submit "Guardar", class: "btn btn-primary" %>
  </div>
<% end %>
