<%= form_with(model: @user, local: true) do |form| %>
  <% if @user.errors.any? %>
    <div class="error-messages">
      <h2>Não foi possível guardar o utilizador:</h2>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :email %><br>
    <%= form.text_field :email %>
  </div>

  <% if action_name == "new" %>
    <div class="field">
      <%= form.label :password, "Palavra-passe" %><br>
      <%= form.password_field :password %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :role, "Função" %><br>
    <%= form.select :role, [["Administrador", "admin"], ["Distribuidor", "distributor"]] %>
  </div>

  <div class="actions">
    <%= form.submit "Guardar", class: "btn btn-primary" %>
  </div>
<% end %>
