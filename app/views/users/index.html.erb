<h1>Recursos Humanos</h1>

<%= link_to "Novo utilizador", new_user_path, class: "btn btn-primary" %>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Função</th>
      <th>Ações</th>
      </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.email %></td>
        <td><%= role_name(user.role) %></td>
        <td>
          <div class="table-actions">
            <%= link_to "Editar", edit_user_path(user), class: "btn btn-small" %>
            <%= link_to "Eliminar", user_path(user), class: "btn btn-small btn-danger",
                  data: { turbo_method: :delete, turbo_confirm: "Tem a certeza?" } %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
